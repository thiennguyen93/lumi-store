# CI artifacts — gh-pages is where they publish, main never holds them.
/dist/
/build/
# Never, anywhere: the signing key lives in the repo secrets alone.
store.key
# Local build leftovers: a crate built in place, and Python's bytecode cache
# from running publish.py. CI builds into /build/ and neither is ever shipped.
target/
__pycache__/

# A web entry's dependencies and build output: installed and built by
# publish.py from the lockfile, never committed.
node_modules/
ext/*/web/dist/
