{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "clipboard-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "ext/dev.thiennguyen.clipboard/web",
        "dev",
        "--port",
        "5178",
        "--strictPort"
      ],
      "port": 5178
    },
    {
      "name": "clipboard-web-2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "ext/dev.thiennguyen.clipboard/web",
        "dev",
        "--port",
        "5179",
        "--strictPort"
      ],
      "port": 5179
    },
    {
      "name": "clipboard-web-3",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "ext/dev.thiennguyen.clipboard/web",
        "dev",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "clipboard-web-auto",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "pnpm -C ext/dev.thiennguyen.clipboard/web dev --port ${PORT:-5181} --strictPort"
      ],
      "port": 5181,
      "autoPort": true
    },
    {
      "name": "sample-ui",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/preview_ui.py",
        "ext/dev.thiennguyen.sample/sample",
        "--port",
        "5190"
      ],
      "port": 5190
    },
    {
      "name": "keytest-ui",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/preview_ui.py",
        "ext/dev.thiennguyen.keytest",
        "--port",
        "5191"
      ],
      "port": 5191
    },
    {
      "name": "clipboard-promo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/preview_ui.py",
        "ext/dev.thiennguyen.clipboard",
        "--port",
        "5192",
        "--proxy",
        "http://localhost:5178"
      ],
      "port": 5192
    },
    {
      "name": "screenshot-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "../lumi-screenshot/web",
        "dev",
        "--port",
        "5183",
        "--strictPort"
      ],
      "port": 5183
    },
    {
      "name": "lumi-kit",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "pnpm -C ../lumi exec vite --port ${PORT:-5274} --strictPort"
      ],
      "port": 5274,
      "autoPort": true
    },
    {
      "name": "lumi-homepage",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "pnpm -C ../lumi/homepage exec vite --port ${PORT:-5299} --strictPort"
      ],
      "port": 5299,
      "autoPort": true
    },
    {
      "name": "sticky-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "../lumi-sticky-notes/web",
        "dev",
        "--port",
        "5185",
        "--strictPort"
      ],
      "port": 5185
    },
    {
      "name": "sticky-promo",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/preview_ui.py",
        "../lumi-sticky-notes",
        "--promo",
        "../lumi-sticky-notes/shots/promo.json",
        "--port",
        "5193",
        "--proxy",
        "http://localhost:5185"
      ],
      "port": 5193
    }
  ]
}
